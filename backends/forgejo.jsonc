// Forgejo backend — issues + label namespaces, no project board.
//
// The real logic lives once in the-cycle's helpers/; each repo commits a thin real-file
// shim at scripts/*.mjs that spawns it, carrying this repo's bindings as env. That shape
// is deliberate: a committed symlink dangles in an isolated CI checkout, and a real file
// is always present (CI never runs it). See docs/BACKENDS.md.
{
  "name": "forgejo",

  // Branch points for skills that must genuinely behave differently.
  "semantics": {
    // There is no board. An issue existing IS enough — nothing to add it to.
    "has_board": false,
    // This Forgejo serves no job-log API; logs come from the ci-logs wrapper.
    "job_logs": "wrapper",
    // The wrapper scans the run list for the first failure, so it needs no run id.
    "job_logs_search": true,
    // No branch protection, so `--auto`-style merge would fire immediately.
    "auto_merge": false
  },

  // Helper shims rendered into the consuming repo. `helper` names a file in the-cycle's
  // helpers/; `env` is this repo's bindings, baked in at render time so the helper needs
  // no knowledge of the repo it is being run from. Empty values are dropped.
  "shims": [
    {
      "path": "scripts/forgejo.mjs",
      "helper": "forgejo.mjs",
      "env": { "FORGEJO_REPO": "{{repo.slug}}", "FORGEJO_API": "{{tracker.api}}" }
    },
    {
      "path": "scripts/forgejo-merge.mjs",
      "helper": "forgejo-merge.mjs",
      "env": { "FORGEJO_REPO": "{{repo.slug}}", "FORGEJO_API": "{{tracker.api}}" }
    },
    {
      "path": "scripts/forgejo-project.mjs",
      "helper": "forgejo-project.mjs",
      "env": {
        "FORGEJO_REPO": "{{repo.slug}}",
        "FORGEJO_API": "{{tracker.api}}",
        "CYCLE_FIELD_NS": "{{tracker.fields_json}}"
      }
    },
    {
      "path": "scripts/ci-logs.mjs",
      "helper": "ci-logs.sh",
      "env": { "FORGEJO_REPO": "{{repo.slug}}", "FORGEJO_API": "{{tracker.api}}" }
    }
  ],

  // Verb → command. Each value is itself a template: {{…}} resolves against config,
  // $1..$9 are the arguments passed at the call site.
  "verbs": {
    "issue_list": "node scripts/forgejo.mjs list --open",
    "issue_list_closed": "node scripts/forgejo.mjs list --state closed --limit 20",
    "issue_list_label": "node scripts/forgejo.mjs list --open --label $1",
    "issue_list_milestone": "node scripts/forgejo.mjs list --open --milestone $1",
    "issue_view": "node scripts/forgejo.mjs issue view $1",
    "issue_create": "node scripts/forgejo.mjs issue create --title $1 --body $2 --label $3",
    "issue_edit_label": "node scripts/forgejo.mjs issue edit $1 --add-label $2",
    "issue_unlabel": "node scripts/forgejo.mjs issue edit $1 --remove-label $2",
    "issue_comment": "node scripts/forgejo.mjs issue comment $1 $2",
    "issue_close": "node scripts/forgejo.mjs issue close $1",

    "pr_create": "node scripts/forgejo.mjs pr create --head $1 --base main --title $2 --body $3",
    "pr_list": "node scripts/forgejo.mjs pr list --state open",
    "pr_view": "node scripts/forgejo.mjs pr view $1",
    "pr_close": "node scripts/forgejo.mjs pr close $1",

    // Backgrounded: polls until CI registers AND finishes, squash-merges only on
    // green, closes referenced issues. On red it prints each failing check plus the
    // tail of that job's log, and exits non-zero.
    "merge_guard": "node scripts/forgejo-merge.mjs $1 --closes $2 &",

    "set_field": "node scripts/forgejo-project.mjs set-field $1 $2 $3",
    "set_status": "node scripts/forgejo-project.mjs status $1 $2",
    "batch": "node scripts/forgejo-project.mjs batch $1",

    "ci_runs": "node scripts/ci-logs.mjs --list",
    "ci_log": "node scripts/ci-logs.mjs $1",
    "ci_log_failed": "node scripts/ci-logs.mjs --failed"
  },

  // Prose the doctrine splices in where the two backends genuinely diverge.
  "notes": {
    "merge_guard": "**Always pass `--closes`** — the issue number(s) already in hand, or **`none`** when the merge should close nothing (a multi-phase PR: \"Phase 2a of #539\"). The guard's body-regex scan is only a fallback for an ad-hoc merge with no `--closes`, and it fires on any `Closes #n` token in prose — even \"will close #539 later\" (bit on a real PR). Editing the body after launch doesn't help; the guard snapshots it at registration.",
    "routing_read": "Routing values are label namespaces. Read one by finding the label with the prefix and stripping it: `labels.find(l => l.startsWith('status/'))?.slice('status/'.length)`. `forgejo-project.mjs` enforces one label per namespace and preserves workflow labels (`bug`, `area:*`, `finding`, `scout`).",
    "unreachable": "All three scripts exit **3** and print `unreachable` on a connection failure. Stop and say so — never fall back to a cached list or a frozen markdown tracker.",
    "done_means": "There is no `status/shipped`; `issue close` is the terminal step, and the merge guard drops any lingering `status/*` label as it closes — a closed issue never keeps one. Pass `--open` when picking work."
  }
}
