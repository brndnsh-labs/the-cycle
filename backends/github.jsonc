// GitHub backend — issues + a real Projects v2 board with typed fields.
//
// `gh` covers most of it; the Projects GraphQL surface is awkward enough from the CLI
// that field writes go through a small committed helper (scripts/gh-project.mjs) with
// a `status` / `set-field` / `batch` interface — the same shape a future backend's
// helper would expose, which is what lets the skills stay backend-agnostic.
{
  "name": "github",

  "semantics": {
    // `gh pr merge --auto` is correct ONLY with branch protection — without it the
    // merge fires immediately with nothing to wait on. Repos without protection use
    // the poll-then-merge guard below instead. This is a per-repo branch-protection
    // fact rather than a backend fact, but relocating it onto that axis is a separate
    // follow-up — for now it's the one semantic flag still declared here.
    "auto_merge": false
  },

  // Config this backend cannot render without. Checked before any template runs, so
  // a missing value is one clear message rather than an "unresolved {{…}}" from deep
  // inside a verb expansion.
  "requires": {
    "tracker.project": "the Projects v2 board number — `gh project list --owner <you>`",
    "tracker.owner": "the account (user or org login) that owns the Projects v2 board — get it wrong and every write silently targets someone else's board"
  },

  // Rendered into the repo; `helper` names a file in the-cycle's helpers/ and `env`
  // carries this repo's board bindings, so the helper hardcodes no target. (mend's
  // hand-written copy baked OWNER/REPO/PROJECT_NUMBER in as literals — that is the
  // config leak this whole design exists to close.)
  "shims": [
    {
      "path": "scripts/gh-project.mjs",
      "helper": "gh-project.mjs",
      "env": {
        "GH_OWNER": "{{tracker.owner}}",
        "GH_PROJECT": "{{tracker.project}}",
        "GH_REPO": "{{repo.slug}}"
      }
    }
  ],

  "verbs": {
    "issue_list": "gh issue list --state open --json number,title,labels,milestone,url",
    "issue_list_closed": "gh issue list --state closed --limit 20 --json number,title,closedAt,url",
    "issue_list_label": "gh issue list --state open --label $1 --json number,title,labels,milestone,url",
    "issue_list_milestone": "gh issue list --state open --milestone $1 --json number,title,labels,milestone,url",
    "issue_view": "gh issue view $1 --json number,title,state,url,labels,milestone,body",
    "issue_create": "gh issue create --title $1 --body $2 --label $3",
    "issue_edit_label": "gh issue edit $1 --add-label $2",
    "issue_unlabel": "gh issue edit $1 --remove-label $2",
    "issue_comment": "gh issue comment $1 --body $2",
    "issue_close": "gh issue close $1",

    "pr_create": "gh pr create --head $1 --base main --title $2 --body $3",
    "pr_list": "gh pr list --state open",
    "pr_view": "gh pr view $1",
    "pr_close": "gh pr close $1",

    // Two-step on purpose: --watch errors with "no checks reported" if it runs before
    // any run exists, so wait for registration first. The && is the guard — merge only
    // happens if every check passed.
    "merge_guard": "(until gh pr checks $1 >/dev/null 2>&1; do sleep 5; done; gh pr checks $1 --watch --fail-fast && gh pr merge $1 --squash --delete-branch) &",

    "set_field": "node scripts/gh-project.mjs set-field $1 $2 $3",
    "set_status": "node scripts/gh-project.mjs status $1 $2",
    "batch": "node scripts/gh-project.mjs batch $1",

    // Board read — GitHub-only; a label-only tracker has no equivalent because the
    // issue list IS the board. There is deliberately no `board_add` counterpart: the
    // helper's status/set-field/batch all ensure board membership first, so an explicit
    // add verb would be a second way to do the same thing, and skills would have to
    // remember to call it.
    "board_list": "gh project item-list {{tracker.project}} --owner {{tracker.owner}} --format json",

    "ci_runs": "gh run list",
    "ci_log": "gh run view $1 --log",
    "ci_log_failed": "gh run view $1 --log-failed"
  }
}
