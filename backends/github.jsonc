// GitHub backend — issues and labels. Nothing else.
//
// Routing state lives in `status:*` labels on the issue itself, so "the board" is just
// the open issue list. This replaced a Projects v2 board in Aug 2026: the board was
// carrying a single-select enum and nothing more (no custom fields, and ranking came
// from milestone+number, never board order), while charging for it in a 175-line
// GraphQL helper, a per-repo shim, a 30-item default page size, and — the bug that
// ended it — item lookup by issue number alone, which silently crossed repos on an
// org-wide board. Labels are repo-scoped by construction, so that class of error is
// unrepresentable rather than merely fixed.
{
  "name": "github",

  "semantics": {
    // `gh pr merge --auto` is correct ONLY with branch protection — without it the
    // merge fires immediately with nothing to wait on. Repos without protection use
    // the poll-then-merge guard below instead. This is a per-repo branch-protection
    // fact rather than a backend fact, but relocating it onto that axis is a separate
    // follow-up — for now it's the one semantic flag still declared here.
    "auto_merge": false
  },

  // No `requires` and no `shims`: every verb below is a plain `gh` call against the
  // repo `gh` already resolves from the checkout, so there is nothing left for a repo
  // to bind wrong and no executable to install.

  "verbs": {
    "issue_list": "gh issue list --state open --json number,title,labels,milestone,url",
    "issue_list_closed": "gh issue list --state closed --limit 20 --json number,title,closedAt,url",
    "issue_list_label": "gh issue list --state open --label $1 --json number,title,labels,milestone,url",
    "issue_list_milestone": "gh issue list --state open --milestone $1 --json number,title,labels,milestone,url",
    "issue_view": "gh issue view $1 --json number,title,state,url,labels,milestone,body",
    "issue_create": "gh issue create --title $1 --body $2 --label $3",
    "issue_edit_label": "gh issue edit $1 --add-label $2",
    "issue_unlabel": "gh issue edit $1 --remove-label $2",
    "issue_comment": "gh issue comment $1 --body $2",
    "issue_close": "gh issue close $1",

    "pr_create": "gh pr create --head $1 --base main --title $2 --body $3",
    "pr_list": "gh pr list --state open",
    "pr_view": "gh pr view $1",
    "pr_close": "gh pr close $1",

    // Two-step on purpose: --watch errors with "no checks reported" if it runs before
    // any run exists, so wait for registration first. The && is the guard — merge only
    // happens if every check passed.
    "merge_guard": "(until gh pr checks $1 >/dev/null 2>&1; do sleep 5; done; gh pr checks $1 --watch --fail-fast && gh pr merge $1 --squash --delete-branch) &",

    // One call, and idempotent: clearing every status label before adding the target
    // keeps the set mutually exclusive without a read first. Both halves are safe —
    // removing a label the issue doesn't carry is a no-op that still exits 0, and the
    // add is applied after the removes, so naming the target in both lists is fine.
    // The labels must EXIST in the repo (`gh` errors on an unknown label, loudly —
    // which is the intended failure, unlike the board's silent misroute).
    //
    // There is no `board_list`: the issue list IS the board, so `issue_list` above is
    // the whole read path, and it carries open/closed state intrinsically instead of
    // needing an intersect. There is no `batch` either — these are REST calls off the
    // 5,000/hr core pool, not GraphQL points, so an ordinary loop is now correct.
    "set_status": "gh issue edit $1 --remove-label \"{{tracker.status_labels}}\" --add-label $2",

    "ci_runs": "gh run list",
    "ci_log": "gh run view $1 --log",
    "ci_log_failed": "gh run view $1 --log-failed"
  }
}
