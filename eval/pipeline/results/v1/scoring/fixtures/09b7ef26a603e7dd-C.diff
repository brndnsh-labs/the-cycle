@@ -0,0 +1,53 @@
+// @vitest-environment happy-dom
+
+import { cleanup, render, screen } from '@testing-library/react'
+import userEvent from '@testing-library/user-event'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { Drawer } from './drawer'
+
+afterEach(cleanup)
+
+describe('Drawer', () => {
+  it('keeps the Close target at 44 px beside a long title at a 390 px viewport', async () => {
+    const onClose = vi.fn()
+    const user = userEvent.setup()
+    const longTitle = 'Adjust the count-in and backing-track balance for this practice session'
+    const viewportWidth = 390
+
+    render(
+      <Drawer open onClose={onClose} title={longTitle}>
+        Drawer content
+      </Drawer>,
+    )
+
+    const dialog = screen.getByRole('dialog', { name: longTitle })
+    const closeButton = screen.getByRole('button', { name: 'Close' })
+    const closeStyle = window.getComputedStyle(closeButton)
+    const headerStyle = window.getComputedStyle(closeButton.parentElement as HTMLElement)
+    const titleStyle = window.getComputedStyle(screen.getByText(longTitle))
+    // Why: happy-dom does not perform layout, so prove the mobile flex budget from
+    // the actual computed dimensions instead of setting an inert window.innerWidth.
+    const titleWidthBudget = viewportWidth
+      - Number.parseFloat(headerStyle.paddingLeft)
+      - Number.parseFloat(headerStyle.paddingRight)
+      - Number.parseFloat(headerStyle.gap)
+      - Number.parseFloat(closeStyle.width)
+
+    expect(dialog.className.split(' ')).toContain('inset-x-0')
+    expect(Number.parseFloat(closeStyle.width)).toBeGreaterThanOrEqual(44)
+    expect(Number.parseFloat(closeStyle.height)).toBeGreaterThanOrEqual(44)
+    expect(closeStyle.flexShrink).toBe('0')
+    expect(titleWidthBudget).toBe(306)
+    expect(
+      Number.parseFloat(closeStyle.height)
+      + Number.parseFloat(headerStyle.paddingTop)
+      + Number.parseFloat(headerStyle.paddingBottom),
+    ).toBe(54)
+    expect(titleStyle.minWidth).toBe('0')
+    expect(titleStyle.overflowWrap).toBe('anywhere')
+    expect(document.activeElement).toBe(dialog)
+
+    await user.click(closeButton)
+    expect(onClose).toHaveBeenCalledOnce()
+  })
+})
