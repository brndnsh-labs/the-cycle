diff --git a/src/components/library/FilterPopover.test.tsx b/src/components/library/FilterPopover.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..2529b26f58df2730876dbcf174bcde8d1d31a7ce
--- /dev/null
+++ b/src/components/library/FilterPopover.test.tsx
@@ -0,0 +1,101 @@
+// @vitest-environment happy-dom
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { cleanup, render, screen } from '@testing-library/react'
+import userEvent from '@testing-library/user-event'
+import { FilterPopover } from './FilterPopover'
+
+afterEach(cleanup)
+
+const ACTIVE_OPEN_NAME = 'Open Mastery filter, current selection: Mastery: Working'
+
+function renderFilter(onClear = vi.fn(), active = true) {
+  return {
+    onClear,
+    ...render(
+      <FilterPopover
+        label="Mastery"
+        active={active}
+        summary={active ? 'Mastery: Working' : undefined}
+        onClear={onClear}
+      >
+        <button type="button">Working option</button>
+      </FilterPopover>,
+    ),
+  }
+}
+
+describe('FilterPopover', () => {
+  it('renders the open trigger and Clear action as sibling buttons with distinct names', () => {
+    renderFilter()
+
+    const open = screen.getByRole('button', { name: ACTIVE_OPEN_NAME })
+    const clear = screen.getByRole('button', { name: 'Clear Mastery' })
+
+    expect(open.tagName).toBe('BUTTON')
+    expect(clear.tagName).toBe('BUTTON')
+    expect(open.contains(clear)).toBe(false)
+    expect(open.parentElement).toBe(clear.parentElement)
+  })
+
+  it('keeps pointer interactions independent', async () => {
+    const user = userEvent.setup()
+    const { onClear } = renderFilter()
+    const open = screen.getByRole('button', { name: ACTIVE_OPEN_NAME })
+    const clear = screen.getByRole('button', { name: 'Clear Mastery' })
+
+    await user.click(clear)
+    expect(onClear).toHaveBeenCalledTimes(1)
+    expect(screen.queryByRole('menu')).toBeNull()
+
+    await user.click(open)
+    expect(onClear).toHaveBeenCalledTimes(1)
+    const panel = screen.getByRole('menu', { name: 'Mastery' })
+    const backdrop = panel.previousElementSibling as HTMLElement
+    const pill = open.parentElement as HTMLElement
+    expect(Number(pill.style.zIndex)).toBeGreaterThan(Number(backdrop.style.zIndex))
+
+    await user.click(clear)
+    expect(onClear).toHaveBeenCalledTimes(2)
+    expect(screen.queryByRole('menu')).toBeNull()
+  })
+
+  it.each(['{Enter}', ' '])('clears with %s without opening the menu', async (key) => {
+    const user = userEvent.setup()
+    const { onClear } = renderFilter()
+    screen.getByRole('button', { name: 'Clear Mastery' }).focus()
+
+    await user.keyboard(key)
+
+    expect(onClear).toHaveBeenCalledTimes(1)
+    expect(screen.queryByRole('menu')).toBeNull()
+  })
+
+  it.each(['{Enter}', ' '])('opens with %s without clearing the filter', async (key) => {
+    const user = userEvent.setup()
+    const { onClear } = renderFilter()
+    screen.getByRole('button', { name: ACTIVE_OPEN_NAME }).focus()
+
+    await user.keyboard(key)
+
+    expect(onClear).not.toHaveBeenCalled()
+    expect(screen.queryByRole('menu', { name: 'Mastery' })).not.toBeNull()
+  })
+
+  it('keeps the visible pill height stable and gives Clear a 44px square target', () => {
+    const view = renderFilter(vi.fn(), false)
+    const inactivePill = screen.getByRole('button', { name: 'Open Mastery filter' }).parentElement as HTMLElement
+    expect(inactivePill.style.height).toBe('38px')
+
+    view.rerender(
+      <FilterPopover label="Mastery" active summary="Mastery: Working" onClear={view.onClear}>
+        <button type="button">Working option</button>
+      </FilterPopover>,
+    )
+
+    const open = screen.getByRole('button', { name: ACTIVE_OPEN_NAME })
+    const clear = screen.getByRole('button', { name: 'Clear Mastery' })
+    expect((open.parentElement as HTMLElement).style.height).toBe('38px')
+    expect(clear.style.width).toBe('44px')
+    expect(clear.style.height).toBe('44px')
+  })
+})
