index 0000000000000000000000000000000000000000..dfbe34e2b899aea9c88e8d7f55ce536b312b216a
--- /dev/null
+++ b/src/components/layout/BlockedDbToastMount.tsx
@@ -0,0 +1,17 @@
+'use client'
+
+import { useEffect } from 'react'
+import { toast } from 'sonner'
+import { subscribeToBlockedDbOpen } from '@/lib/stems/db-open-notifications'
+
+/** Surfaces recovery guidance for an IndexedDB schema upgrade blocked by another tab. */
+export function BlockedDbToastMount() {
+  useEffect(() => subscribeToBlockedDbOpen(({ generation, message }) => {
+    toast.error(message, {
+      id: `blocked-db-open-${generation}`,
+      duration: 10_000,
+    })
+  }), [])
+
+  return null
+}
diff --git a/src/lib/stems/db-open-notifications.ts b/src/lib/stems/db-open-notifications.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6576a2b63869ff1e117d2313dc6b5669dc5516df
--- /dev/null
+++ b/src/lib/stems/db-open-notifications.ts
@@ -0,0 +1,28 @@
+export const BLOCKED_DB_OPEN_MESSAGE =
+  'Songs I Know could not update its local database. Close other Songs I Know tabs and reload this page.'
+
+export type BlockedDbOpenNotification = {
+  generation: number
+  message: string
+}
+
+type Listener = (notification: BlockedDbOpenNotification) => void
+
+const listeners = new Set<Listener>()
+const publishedGenerations = new Set<number>()
+
+/** Publish at most one recovery notification for each IndexedDB open attempt. */
+export function notifyBlockedDbOpen(generation: number): void {
+  if (publishedGenerations.has(generation)) return
+  publishedGenerations.add(generation)
+
+  const notification = { generation, message: BLOCKED_DB_OPEN_MESSAGE }
+  listeners.forEach((listener) => {
+    try { listener(notification) } catch { /* one toast listener must not starve the rest */ }
+  })
+}
+
+export function subscribeToBlockedDbOpen(listener: Listener): () => void {
+  listeners.add(listener)
+  return () => listeners.delete(listener)
+}
