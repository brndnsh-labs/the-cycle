index 0000000000000000000000000000000000000000..11a1da57b40f37185f30b6a5f9d844a9c5c1d418
--- /dev/null
+++ b/src/components/layout/StemsStoreErrorToastMount.tsx
@@ -0,0 +1,18 @@
+'use client'
+
+import { useEffect } from 'react'
+import { toast } from 'sonner'
+import { observeBlockedStemsStoreOpen } from '@/lib/stems/store'
+
+/** Bridges the stems store's one-per-generation blocked-open signal into the
+ * app-wide Sonner mount. It renders nothing and is mounted once by AppShell. */
+export function StemsStoreErrorToastMount() {
+  useEffect(() => observeBlockedStemsStoreOpen((error) => {
+    toast.error('Storage update blocked', {
+      description: error.message,
+      duration: 10_000,
+    })
+  }), [])
+
+  return null
+}
