diff --git a/src/components/layout/StemsStoreErrorToastMount.test.tsx b/src/components/layout/StemsStoreErrorToastMount.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..1ae7a1397d65f34eaec7a9af9271083b1b0ae811
--- /dev/null
+++ b/src/components/layout/StemsStoreErrorToastMount.test.tsx
@@ -0,0 +1,54 @@
+// @vitest-environment happy-dom
+
+import { act, cleanup, render } from '@testing-library/react'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { StemsStoreErrorToastMount } from './StemsStoreErrorToastMount'
+
+const mocks = vi.hoisted(() => ({
+  listener: null as ((error: Error) => void) | null,
+  observe: vi.fn(),
+  toastError: vi.fn(),
+  unsubscribe: vi.fn(),
+}))
+
+vi.mock('@/lib/stems/store', () => ({
+  observeBlockedStemsStoreOpen: mocks.observe,
+}))
+vi.mock('sonner', () => ({
+  toast: { error: mocks.toastError },
+}))
+
+describe('StemsStoreErrorToastMount', () => {
+  beforeEach(() => {
+    mocks.listener = null
+    mocks.observe.mockReset()
+    mocks.toastError.mockReset()
+    mocks.unsubscribe.mockReset()
+    mocks.observe.mockImplementation((listener: (error: Error) => void) => {
+      mocks.listener = listener
+      return mocks.unsubscribe
+    })
+  })
+
+  afterEach(cleanup)
+
+  it('surfaces blocked store recovery guidance through one app-wide error toast', () => {
+    const view = render(<StemsStoreErrorToastMount />)
+    expect(mocks.observe).toHaveBeenCalledOnce()
+
+    act(() => {
+      mocks.listener?.(new Error(
+        'Songs I Know storage is still open in another tab. Close other Songs I Know tabs, then reload this page.',
+      ))
+    })
+
+    expect(mocks.toastError).toHaveBeenCalledOnce()
+    expect(mocks.toastError).toHaveBeenCalledWith('Storage update blocked', {
+      description: expect.stringMatching(/close other Songs I Know tabs, then reload/i),
+      duration: 10_000,
+    })
+
+    view.unmount()
+    expect(mocks.unsubscribe).toHaveBeenCalledOnce()
+  })
+})
diff --git a/src/components/layout/StemsStoreErrorToastMount.tsx b/src/components/layout/StemsStoreErrorToastMount.tsx
