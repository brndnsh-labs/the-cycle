+// @vitest-environment happy-dom
+
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { cleanup, render, screen } from '@testing-library/react'
+import userEvent from '@testing-library/user-event'
+import { Drawer } from './drawer'
+
+afterEach(cleanup)
+
+describe('Drawer close button', () => {
+  it('keeps a 44px non-shrinking touch target beside a long title', () => {
+    render(
+      <Drawer
+        open
+        onClose={() => undefined}
+        title="Share an exceptionally long setlist title that must not crowd the close control"
+      >
+        Drawer body
+      </Drawer>,
+    )
+
+    const close = screen.getByRole('button', { name: 'Close' })
+    const style = getComputedStyle(close)
+    const title = screen.getByText(/Share an exceptionally long setlist title/)
+    const titleStyle = getComputedStyle(title)
+    const headerStyle = getComputedStyle(close.parentElement as HTMLElement)
+
+    expect(Number.parseFloat(style.width)).toBeGreaterThanOrEqual(44)
+    expect(Number.parseFloat(style.height)).toBeGreaterThanOrEqual(44)
+    expect(style.flexShrink).toBe('0')
+    expect(Number.parseFloat(titleStyle.minWidth)).toBe(0)
+    expect(titleStyle.overflow).toBe('hidden')
+    expect(titleStyle.textOverflow).toBe('ellipsis')
+    expect(titleStyle.whiteSpace).toBe('nowrap')
+    expect(Number.parseFloat(headerStyle.gap)).toBeGreaterThan(0)
+  })
+
+  it('invokes onClose when clicked', async () => {
+    const onClose = vi.fn()
+    const user = userEvent.setup()
+    render(<Drawer open onClose={onClose} title="Adjust">Drawer body</Drawer>)
+
+    await user.click(screen.getByRole('button', { name: 'Close' }))
+
+    expect(onClose).toHaveBeenCalledTimes(1)
+  })
+})
