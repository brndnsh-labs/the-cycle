+++ b/src/app/api/payments/webhook/route.test.ts
@@ -0,0 +1,205 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+import { NextRequest } from 'next/server'
+import type Stripe from 'stripe'
+
+const mocks = vi.hoisted(() => ({
+  constructEvent: vi.fn(),
+  createPayment: vi.fn(),
+  nanoid: vi.fn(() => 'payment-id'),
+}))
+
+vi.mock('@/lib/payments/stripe', () => ({
+  stripe: { webhooks: { constructEvent: mocks.constructEvent } },
+}))
+vi.mock('@/lib/db/queries/payments', () => ({ createPayment: mocks.createPayment }))
+vi.mock('nanoid', () => ({ nanoid: mocks.nanoid }))
+
+process.env.STRIPE_WEBHOOK_SECRET = 'whsec_test'
+
+const { POST } = await import('@/app/api/payments/webhook/route')
+
+const URL = 'http://localhost:3000/api/payments/webhook'
+const MAX_BODY_BYTES = 1_000_000
+
+function request(
+  body: BodyInit | null,
+  options: { signature?: string; contentLength?: string } = {},
+): NextRequest {
+  const headers = new Headers()
+  if (options.signature !== undefined) headers.set('stripe-signature', options.signature)
+  if (options.contentLength !== undefined) headers.set('content-length', options.contentLength)
+
+  return new NextRequest(URL, { method: 'POST', headers, body })
+}
+
+function streamedRequest(chunks: Uint8Array[], contentLength?: string): NextRequest {
+  const stream = new ReadableStream<Uint8Array>({
+    start(controller) {
+      for (const chunk of chunks) controller.enqueue(chunk)
+      controller.close()
+    },
+  })
+
+  return request(stream, { signature: 'signature', contentLength })
+}
+
+function event(type: string, object: unknown = {}): Stripe.Event {
+  return { type, data: { object } } as Stripe.Event
+}
+
+beforeEach(() => {
+  vi.resetAllMocks()
+  mocks.nanoid.mockReturnValue('payment-id')
+  mocks.constructEvent.mockReturnValue(event('ignored.event'))
+})
+
+describe('POST /api/payments/webhook body bounds', () => {
+  it('returns 400 for a missing signature without accessing the body', async () => {
+    const req = {
+      headers: new Headers(),
+      get body(): never {
+        throw new Error('body must not be read')
+      },
+    } as unknown as NextRequest
+
+    const response = await POST(req)
+
+    expect(response.status).toBe(400)
+    expect(mocks.constructEvent).not.toHaveBeenCalled()
+  })
+
+  it('returns 413 for a declared body above the limit without accessing the body', async () => {
+    const req = {
+      headers: new Headers({
+        'stripe-signature': 'signature',
+        'content-length': String(MAX_BODY_BYTES + 1),
+      }),
+      get body(): never {
+        throw new Error('body must not be read')
+      },
+    } as unknown as NextRequest
+
+    const response = await POST(req)
+
+    expect(response.status).toBe(413)
+    expect(mocks.constructEvent).not.toHaveBeenCalled()
+  })
+
+  it.each([
+    ['an absent header', undefined],
+    ['an invalid header', 'not-a-number'],
+    ['a deceptively smaller header', '1'],
+  ])('returns 413 for streamed overflow with %s', async (_description, contentLength) => {
+    const response = await POST(streamedRequest([
+      new Uint8Array(MAX_BODY_BYTES),
+      new Uint8Array([1]),
+    ], contentLength))
+
+    expect(response.status).toBe(413)
+    expect(mocks.constructEvent).not.toHaveBeenCalled()
+  })
+
+  it('passes an exact-limit body to Stripe byte-for-byte without decoding it', async () => {
+    const body = new Uint8Array(MAX_BODY_BYTES)
+    for (let index = 0; index < body.length; index += 1) body[index] = index % 256
+
+    const response = await POST(streamedRequest([
+      body.subarray(0, 333_333),
+      body.subarray(333_333, 777_777),
+      body.subarray(777_777),
+    ], String(MAX_BODY_BYTES)))
+
+    expect(response.status).toBe(200)
+    expect(mocks.constructEvent).toHaveBeenCalledOnce()
+    const [payload, signature, secret] = mocks.constructEvent.mock.calls[0]
+    expect(payload).toBeInstanceOf(Uint8Array)
+    expect(payload).toEqual(body)
+    expect(signature).toBe('signature')
+    expect(secret).toBe('whsec_test')
+  })
+})
+
+describe('POST /api/payments/webhook payment behavior', () => {
+  it('returns 400 when Stripe rejects a malformed or invalidly signed body', async () => {
+    mocks.constructEvent.mockImplementation(() => {
+      throw new Error('invalid signature')
+    })
+
+    const response = await POST(request('{', { signature: 'signature' }))
+
+    expect(response.status).toBe(400)
+    expect(mocks.createPayment).not.toHaveBeenCalled()
+  })
+
+  it('does not create a payment for an unpaid completed session', async () => {
+    mocks.constructEvent.mockReturnValue(event('checkout.session.completed', {
+      payment_status: 'unpaid',
+      metadata: { userId: 'user-1' },
+      payment_intent: 'pi_123',
+      amount_total: 2500,
+    }))
+
+    const response = await POST(request('{}', { signature: 'signature' }))
+
+    expect(response.status).toBe(200)
+    expect(mocks.createPayment).not.toHaveBeenCalled()
+  })
+
+  it.each([
+    ['missing user metadata', { payment_intent: 'pi_123', amount_total: 2500 }],
+    ['missing payment intent', { metadata: { userId: 'user-1' }, amount_total: 2500 }],
+    ['a non-positive amount', { metadata: { userId: 'user-1' }, payment_intent: 'pi_123', amount_total: 0 }],
+  ])('does not create a payment for a paid session with %s', async (_description, fields) => {
+    mocks.constructEvent.mockReturnValue(event('checkout.session.completed', {
+      payment_status: 'paid',
+      ...fields,
+    }))
+
+    const response = await POST(request('{}', { signature: 'signature' }))
+
+    expect(response.status).toBe(200)
+    expect(mocks.createPayment).not.toHaveBeenCalled()
+  })
+
+  it('creates a succeeded payment for a valid paid session', async () => {
+    mocks.constructEvent.mockReturnValue(event('checkout.session.completed', {
+      payment_status: 'paid',
+      metadata: { userId: 'user-1' },
+      payment_intent: 'pi_123',
+      customer: 'cus_123',
+      amount_total: 2500,
+    }))
+
+    const response = await POST(request('{}', { signature: 'signature' }))
+
+    expect(response.status).toBe(200)
+    expect(mocks.createPayment).toHaveBeenCalledWith({
+      id: 'payment-id',
+      userId: 'user-1',
+      stripePaymentIntentId: 'pi_123',
+      stripeCustomerId: 'cus_123',
+      amountCents: 2500,
+      status: 'succeeded',
+      createdAt: expect.any(Number),
+    })
+  })
+
+  it('acknowledges a duplicate delivery when payment creation rejects it', async () => {
+    mocks.constructEvent.mockReturnValue(event('checkout.session.completed', {
+      payment_status: 'paid',
+      metadata: { userId: 'user-1' },
+      payment_intent: 'pi_123',
+      customer: null,
+      amount_total: 2500,
+    }))
+    mocks.createPayment.mockImplementation(() => {
+      throw new Error('unique constraint')
+    })
+
+    const response = await POST(request('{}', { signature: 'signature' }))
+
+    expect(response.status).toBe(200)
+    await expect(response.json()).resolves.toEqual({ received: true })
+    expect(mocks.createPayment).toHaveBeenCalledOnce()
+  })
+})
