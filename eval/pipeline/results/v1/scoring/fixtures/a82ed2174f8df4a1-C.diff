--- /dev/null
+++ b/src/components/library/FilterPopover.test.tsx
@@ -0,0 +1,45 @@
+// @vitest-environment happy-dom
+import { cleanup, render, screen } from '@testing-library/react'
+import userEvent from '@testing-library/user-event'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { FilterPopover } from './FilterPopover'
+
+afterEach(cleanup)
+
+describe('FilterPopover', () => {
+  it('clears an active filter without opening its options', async () => {
+    const user = userEvent.setup()
+    const onClear = vi.fn()
+    render(
+      <FilterPopover label="Tempo" active summary="Tempo: Fast" onClear={onClear}>
+        <span>Tempo options</span>
+      </FilterPopover>,
+    )
+
+    const trigger = screen.getByRole('button', { name: 'Tempo: Fast' })
+    const clear = screen.getByRole('button', { name: 'Clear Tempo' })
+
+    // The clear action must be a sibling control, not an invalid button nested
+    // inside the popover trigger. Browsers repair nested buttons inconsistently.
+    expect(trigger.contains(clear)).toBe(false)
+
+    await user.click(clear)
+
+    expect(onClear).toHaveBeenCalledOnce()
+    expect(screen.queryByRole('menu')).toBeNull()
+  })
+
+  it('still opens the options from the filter label', async () => {
+    const user = userEvent.setup()
+    render(
+      <FilterPopover label="Tempo" active summary="Tempo: Fast" onClear={() => {}}>
+        <span>Tempo options</span>
+      </FilterPopover>,
+    )
+
+    await user.click(screen.getByRole('button', { name: 'Tempo: Fast' }))
+
+    expect(screen.getByRole('menu', { name: 'Tempo' })).not.toBeNull()
+    expect(screen.getByText('Tempo options')).not.toBeNull()
+  })
+})
