@@ -0,0 +1,81 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+import { NextRequest } from 'next/server'
+
+const mocks = vi.hoisted(() => ({
+  constructEvent: vi.fn(),
+  createPayment: vi.fn(),
+}))
+
+vi.mock('@/lib/payments/stripe', () => ({
+  stripe: { webhooks: { constructEvent: mocks.constructEvent } },
+}))
+
+vi.mock('@/lib/db/queries/payments', () => ({
+  createPayment: mocks.createPayment,
+}))
+
+const { POST } = await import('@/app/api/payments/webhook/route')
+
+const URL = 'http://localhost:3000/api/payments/webhook'
+const MAX_WEBHOOK_BODY_BYTES = 1_000_000
+
+function request(body: BodyInit, headers: Record<string, string> = {}) {
+  return new NextRequest(URL, {
+    method: 'POST',
+    headers: { 'stripe-signature': 'test-signature', ...headers },
+    body,
+  })
+}
+
+beforeEach(() => {
+  vi.clearAllMocks()
+  mocks.constructEvent.mockReturnValue({ type: 'customer.created' })
+})
+
+describe('POST /api/payments/webhook body limit', () => {
+  it('passes the unmodified raw body to Stripe within the limit', async () => {
+    const rawBody = '{"type":"customer.created","name":"café"}'
+
+    const response = await POST(request(rawBody))
+
+    expect(response.status).toBe(200)
+    expect(mocks.constructEvent).toHaveBeenCalledOnce()
+    expect(mocks.constructEvent.mock.calls[0]![0]).toEqual(Buffer.from(rawBody))
+  })
+
+  it('rejects an oversized Content-Length without verifying the signature', async () => {
+    const response = await POST(request('{}', {
+      'content-length': String(MAX_WEBHOOK_BODY_BYTES + 1),
+    }))
+
+    expect(response.status).toBe(413)
+    await expect(response.json()).resolves.toEqual({ error: 'Payload too large' })
+    expect(mocks.constructEvent).not.toHaveBeenCalled()
+  })
+
+  it('stops and rejects a streamed body that exceeds the limit', async () => {
+    const chunk = new Uint8Array(600 * 1024)
+    const body = new ReadableStream<Uint8Array>({
+      start(controller) {
+        controller.enqueue(chunk)
+        controller.enqueue(chunk)
+        controller.close()
+      },
+    })
+
+    const response = await POST(request(body))
+
+    expect(response.status).toBe(413)
+    expect(mocks.constructEvent).not.toHaveBeenCalled()
+  })
+
+  it('accepts a body exactly at the limit', async () => {
+    const body = new Uint8Array(MAX_WEBHOOK_BODY_BYTES)
+
+    const response = await POST(request(body))
+
+    expect(response.status).toBe(200)
+    expect(mocks.constructEvent).toHaveBeenCalledOnce()
+    expect(mocks.constructEvent.mock.calls[0]![0]).toHaveLength(MAX_WEBHOOK_BODY_BYTES)
+  })
+})
