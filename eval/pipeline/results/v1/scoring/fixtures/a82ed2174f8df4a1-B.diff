index 0000000000000000000000000000000000000000..db1b764f7e49c91d8298c1b8325079265af4eb22
--- /dev/null
+++ b/src/components/library/FilterPopover.test.tsx
@@ -0,0 +1,98 @@
+// @vitest-environment happy-dom
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { cleanup, render, screen } from '@testing-library/react'
+import userEvent from '@testing-library/user-event'
+import { FilterPopover } from './FilterPopover'
+
+afterEach(cleanup)
+
+function filter(onClear = vi.fn(), active = true) {
+  return (
+    <FilterPopover
+      label="Mastery"
+      active={active}
+      summary={active ? 'Mastery: Working' : undefined}
+      onClear={onClear}
+    >
+      <button type="button">Working option</button>
+    </FilterPopover>
+  )
+}
+
+describe('FilterPopover controls', () => {
+  it('renders separately named sibling buttons in one visual pill', () => {
+    render(filter())
+
+    const open = screen.getByRole('button', { name: 'Open Mastery filter' })
+    const clear = screen.getByRole('button', { name: 'Clear Mastery filter' })
+    const pill = screen.getByRole('group', { name: 'Mastery filter controls' })
+
+    expect(open.parentElement).toBe(pill)
+    expect(clear.parentElement).toBe(pill)
+    expect(open.contains(clear)).toBe(false)
+    expect(clear.contains(open)).toBe(false)
+  })
+
+  it('keeps pointer behavior independent', async () => {
+    const user = userEvent.setup()
+    const onClear = vi.fn()
+    render(filter(onClear))
+
+    await user.click(screen.getByRole('button', { name: 'Clear Mastery filter' }))
+    expect(onClear).toHaveBeenCalledTimes(1)
+    expect(screen.queryByRole('menu')).toBeNull()
+
+    await user.click(screen.getByRole('button', { name: 'Open Mastery filter' }))
+    expect(onClear).toHaveBeenCalledTimes(1)
+    expect(screen.getByRole('menu', { name: 'Mastery' })).not.toBeNull()
+  })
+
+  it('lets Enter and Space clear without opening the menu', async () => {
+    const user = userEvent.setup()
+    const onClear = vi.fn()
+    render(filter(onClear))
+    const clear = screen.getByRole('button', { name: 'Clear Mastery filter' })
+
+    clear.focus()
+    await user.keyboard('{Enter}')
+    expect(onClear).toHaveBeenCalledTimes(1)
+    expect(screen.queryByRole('menu')).toBeNull()
+
+    clear.focus()
+    await user.keyboard(' ')
+    expect(onClear).toHaveBeenCalledTimes(2)
+    expect(screen.queryByRole('menu')).toBeNull()
+  })
+
+  it('lets Enter and Space open the menu without clearing', async () => {
+    const user = userEvent.setup()
+    const onClear = vi.fn()
+    render(filter(onClear))
+    const open = screen.getByRole('button', { name: 'Open Mastery filter' })
+
+    open.focus()
+    await user.keyboard('{Enter}')
+    expect(screen.getByRole('menu', { name: 'Mastery' })).not.toBeNull()
+    expect(onClear).not.toHaveBeenCalled()
+
+    await user.keyboard('{Escape}')
+    open.focus()
+    await user.keyboard(' ')
+    expect(screen.getByRole('menu', { name: 'Mastery' })).not.toBeNull()
+    expect(onClear).not.toHaveBeenCalled()
+  })
+
+  it('keeps the visible pill at 38px and gives Clear a 44px target', () => {
+    const view = render(filter(undefined, false))
+    const inactiveHeight = screen.getByRole('group', { name: 'Mastery filter controls' }).style.height
+
+    view.rerender(filter())
+    const pill = screen.getByRole('group', { name: 'Mastery filter controls' })
+    const clear = screen.getByRole('button', { name: 'Clear Mastery filter' })
+
+    expect(inactiveHeight).toBe('38px')
+    expect(pill.style.height).toBe(inactiveHeight)
+    expect(Number.parseFloat(clear.style.width)).toBeGreaterThanOrEqual(44)
+    expect(Number.parseFloat(clear.style.height)).toBeGreaterThanOrEqual(44)
+  })
+})
