+// @vitest-environment happy-dom
+
+import { cleanup, fireEvent, render, screen } from '@testing-library/react'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+
+vi.mock('@/lib/use-mounted', () => ({ useMounted: () => true }))
+
+import { Drawer } from './drawer'
+
+afterEach(cleanup)
+
+describe('Drawer', () => {
+  it('gives the close button a 44px tap target', () => {
+    const onClose = vi.fn()
+    render(
+      <Drawer open onClose={onClose} title="Test drawer">
+        Drawer contents
+      </Drawer>,
+    )
+
+    const closeButton = screen.getByRole('button', { name: 'Close' })
+    expect(closeButton.style.width).toBe('44px')
+    expect(closeButton.style.height).toBe('44px')
+
+    fireEvent.click(closeButton)
+    expect(onClose).toHaveBeenCalledOnce()
+  })
+})
