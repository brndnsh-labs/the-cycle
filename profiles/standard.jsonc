// standard — lean, plus /unblock for repos that accumulate decisions and hands-on checks.
{
  "name": "standard",
  "skills": [
    "cycle",
    "intake",
    "review",
    "next",
    "scout",
    "wrap-up",
    { "skill": "dep-update", "when": "deps.has_manager" },
    { "skill": "deploy-test", "when": "deploy.test" },
    { "skill": "deploy-prod", "when": "deploy.prod" },

    "unblock"
  ]
}
