// full — identical to standard. The skills that once set it apart (nightly, fan-out,
// cover, flake) were retired as unused; the name stays so existing configs resolve.
{
  "name": "full",
  "skills": [
    "cycle",
    "intake",
    "review",
    "next",
    "scout",
    "wrap-up",
    { "skill": "dep-update", "when": "deps.has_manager" },
    { "skill": "deploy-test", "when": "deploy.test" },
    { "skill": "deploy-prod", "when": "deploy.prod" },

    "unblock"
  ]
}
