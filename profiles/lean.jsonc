// lean — the build loop plus the small maintenance layer every repo uses.
// Deploy skills render only when this repo configures a deploy target; dep-update only
// when it has a dependency manager — an unusable skill is just noise in the skill list.
{
  "name": "lean",
  "skills": [
    "cycle",
    "intake",
    "review",
    "next",
    "scout",
    "wrap-up",
    { "skill": "dep-update", "when": "deps.has_manager" },
    { "skill": "deploy-test", "when": "deploy.test" },
    { "skill": "deploy-prod", "when": "deploy.prod" }
  ]
}
