// the-cycle bindings for this repo.
// Everything repo-specific lives here; the skills in .claude/skills are rendered
// from shared templates and should not be hand-edited (`cycle check` will tell you
// if they have been). Re-render with `cycle update` after changing this file.
{
  "repo": {
    "name": "the-cycle",
    "slug": "brndnsh-labs/the-cycle",
    "human": "Brandon"
  },
  "profile": "lean",
  "backend": "github",
  "tracker": {
    // Routing lives in `status:*` labels on the issue. Each name below is a real
    // label that must exist in the repo — `gh` fails loudly on one that doesn't,
    // which is the point: the Projects v2 board this replaced misrouted silently.
    // Every write clears the whole set before adding one, so the states stay
    // mutually exclusive. No label = the untriaged pile (DOCTRINE §1 renders that
    // row itself; don't add a "(none)" entry here or it becomes a real label).
    "description": "the **GitHub repo's issues** (`brndnsh-labs/the-cycle`), routed by `status:*` labels",
    "statuses": [
      {
        "name": "status:ready",
        "meaning": "scoped + pickable",
        "action": "`/next` ranks & picks; `/implement`/`/cycle` build"
      },
      {
        "name": "status:in-progress",
        "meaning": "being built",
        "action": "don't re-pick"
      },
      {
        "name": "status:in-review",
        "meaning": "built, under review / PR open",
        "action": "don't re-pick"
      },
      {
        "name": "status:needs-decision",
        "meaning": "blocked on a human call",
        "action": "surface it; **don't build**"
      },
      {
        "name": "status:blocked",
        "meaning": "blocked on a dependency",
        "action": "skip; name the blocker"
      }
    ],
    "status": {
      "pickable": "status:ready",
      "active": "status:in-progress",
      "done": "status:in-review",
      "decision": "status:needs-decision"
    },
    "ranking": "**milestone first** (a real numbered epic beats no milestone), then **issue number** (lower first)",
    "milestones": []
  },
  "routing": {
    "model": "**opus for everything** (spawned agents included).",
    "executor_default": "orchestrator-inline"
  },
  "gates": {
    "test": "npm test"
  },
  "deps": {
    "outdated": "npm outdated",
    "audit": "npm audit",
    "audit_fix": "npm audit fix",
    "update": "npm update",
    "install": "npm install",
    "manifests": [
      "package.json",
      "package-lock.json"
    ]
  },
  "brakes": [
    "auth / tokens / secrets",
    "schema / data migration",
    "anything destructive or irreversible"
  ],
  "branch": {
    // main is server-protected — no direct pushes, no minor-edits carve-out.
    // The required status check is the bare job name `gates`; a scoped form like
    // "CI / gates (pull_request)" would create a check that never reports, so no
    // PR could ever merge and the merge guard would hang forever.
    "minor_edits_direct": false
  },
  "commit": {
    "coauthor": "Claude Opus 5 <noreply@anthropic.com>"
  },
  "deploy": {
    "test": "",
    "prod": ""
  }
}
